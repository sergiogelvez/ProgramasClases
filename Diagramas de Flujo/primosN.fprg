<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="primosN"/>
        <attribute name="authors" value="CENTIC"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-02 07:21:06 AM"/>
        <attribute name="created" value="Q0VOVElDO0hCMi0yOzIwMjYtMDktMDI7MDc6MTI6MDUgQU07MTk4Ng=="/>
        <attribute name="edited" value="Q0VOVElDO0hCMi0yOzIwMjYtMDktMDI7MDc6MjE6MDYgQU07NDsyMDk4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, num, i, divisores" type="Integer" array="False" size=""/>
            <input variable="n"/>
            <for variable="num" start="2" end="n" direction="inc" step="1">
                <assign variable="divisores" expression="0"/>
                <for variable="i" start="2" end="num - 1" direction="inc" step="1">
                    <if expression="num % i == 0">
                        <then>
                            <assign variable="divisores" expression="divisores + 1"/>
                        </then>
                        <else/>
                    </if>
                </for>
                <if expression="divisores &gt; 0">
                    <then/>
                    <else>
                        <output expression="num" newline="True"/>
                    </else>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>

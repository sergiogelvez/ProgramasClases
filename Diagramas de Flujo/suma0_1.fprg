    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="suma, elemento" type="Integer" array="False" size=""/>
            <input variable="elemento"/>
            <assign variable="suma" expression="0"/>
            <while expression="elemento != 0">
                <assign variable="suma" expression="suma + elemento"/>

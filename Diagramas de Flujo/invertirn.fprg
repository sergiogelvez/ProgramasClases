<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="invertirn"/>
        <attribute name="authors" value="CENTIC"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-26 09:12:33 AM"/>
        <attribute name="created" value="Q0VOVElDO0hCMi0yOzIwMjYtMDgtMjY7MDk6MDE6NDggQU07MTk5OA=="/>
        <attribute name="edited" value="Q0VOVElDO0hCMi0yOzIwMjYtMDgtMjY7MDk6MTI6MzMgQU07NDsyMTA1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, res, resultado" type="Integer" array="False" size=""/>
            <input variable="numero"/>
            <assign variable="resultado" expression="0"/>
            <while expression="numero &gt; 0">
                <assign variable="res" expression="numero % 10"/>
                <assign variable="numero" expression="numero / 10"/>
                <output expression="res" newline="True"/>
                <assign variable="resultado" expression="resultado * 10 + res"/>
                <output expression="resultado" newline="True"/>
            </while>
        </body>
    </function>
</flowgorithm>

# ── Archivos sin extensión (ejecutables de C++ en Linux) ──
# Ignora todo...
*
# ...pero permite recorrer directorios (git no rastrea carpetas vacías)
!*/
# ...y vuelve a incluir todo lo que tenga extensión
!*.*

# Excepciones: archivos sin extensión que SÍ deben versionarse
!Makefile
!makefile
!LICENSE
!README
!Dockerfile

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Miscellaneous
.vscode
.zed
execs
*.pdb
__*__

# Images
*.png

# ===== Python =====

# Bytecode / caché
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales (venv, virtualenv, pipenv, poetry)
venv/
.venv/
env/
.ENV/
ENV/
env.bak/
venv.bak/
Pipfile.lock   # solo si usas Poetry/pipenv y NO quieres versionar el lock

# Distribución / empaquetado
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Instaladores y paquetes compilados
wheels/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Herramientas de pruebas y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml

# Type checking / linting
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Notebooks de Jupyter (opcional)
.ipynb_checkpoints/

# Variables de entorno y secretos
.env
.env.*

# Entornos de editors (si ya los tienes de la parte de C++, evita duplicar)
.idea/
